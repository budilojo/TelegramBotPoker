# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Подробно, по шагам — bot/README.md, раздел «Запуск».

# Токен от @BotFather.
BOT_TOKEN=

# Публичный HTTPS-адрес стола. `npm run go` поднимает туннель и вписывает
# адрес сюда сам — заполнять руками нужно только при своём хостинге.
# Этот же адрес должен стоять у @BotFather как Web App URL.
WEBAPP_URL=

# Короткое имя мини-приложения из @BotFather → /newapp (например, WorldCard).
MINIAPP=

# Кто видит админку: Telegram-id через запятую. Свой id — у @userinfobot.
# Пустой список = админки нет ни у кого.
ADMINS=
# Друзья-тестеры косметики (необязательно): Telegram-id через запятую. Вещи магазина у них разблокированы.
COSMETICS_TESTERS=

# Демонстрационная среда коллекции «Графит» — ТОЛЬКО для демонстрационной среды, не для рабочего
# сервера. Включается значением ровно 1 (не true, не yes, без пробелов). При ней в «Настройках»
# появляется строка «Коллекции» и можно «получить» предметы без оплаты. В рабочем режиме строку
# оставьте закомментированной: коллекции закрыты, демо-записи в базе игнорируются.
# COLLECTIONS_DEMO=1

# Покупки косметики за Telegram Stars (docs/next-release/payment-design.md). ПО УМОЛЧАНИЮ ЗАКРЫТЫ.
# SALES_MODE=test — только вместе с TG_TEST_ENV=1: бот подключается к ТЕСТОВОЙ среде Telegram (нужен
#   отдельный тестовый бот и тестовый аккаунт), звёзды там ненастоящие.
# SALES_MODE=live — настоящие продажи. Откроются, только если: цены утверждены в bot/payments/offers.json,
#   задан PAY_SUPPORT, документы docs/next-release/legal/ «Действует» и без пустых полей. Ставя live, владелец
#   подтверждает и то, что код проверить не может (юрист, бухгалтер, РКН, проверка на телефоне).
# PAY_SUPPORT — публичный контакт поддержки покупок (его покажет /paysupport).
# SALES_MODE=
# TG_TEST_ENV=1
# PAY_SUPPORT=

# Токен ОТДЕЛЬНОГО админ-бота (необязательно). Заведите второго бота у
# @BotFather, впишите токен сюда — и он будет отвечать в личке только тем, чей
# id стоит в ADMINS: /stats, /now, /stop <код>, /health. Всем остальным он
# молчит. Без этой строки игра работает как раньше.
ADMIN_BOT_TOKEN=

# Необязательно:
# PORT=8080
# DB_PATH=./data/bot.db
# TZ=Europe/Moscow
# DRAW_INTERVAL_MS=1000
