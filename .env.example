# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Подробно, по шагам — bot/README.md, раздел «Запуск».

# Токен от @BotFather.
BOT_TOKEN=

# Публичный HTTPS-адрес стола. Для игры с ноутбука:
#   cloudflared tunnel --url http://localhost:8080
# и вписать сюда адрес, который он покажет (https://….trycloudflare.com).
# Тот же адрес — в @BotFather как Web App URL.
WEBAPP_URL=

# Короткое имя мини-приложения из @BotFather → /newapp (например, table).
MINIAPP=

# Необязательно:
# PORT=8080
# DB_PATH=./data/bot.db
# TZ=Europe/Moscow
# DRAW_INTERVAL_MS=1000
