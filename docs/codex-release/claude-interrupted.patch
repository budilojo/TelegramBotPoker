 });
 
+test('PAY_SUPPORT=bot без ADMINS: «напишите сюда» некому прочитать — live не открывается, счёта нет (проверка I)', async () => {
+  // С владельцем в ADMINS и всем остальным заполненным — открыто: причина только в пустом ADMINS.
+  const ok = shop({ mode: 'live', support: 'bot' });
+  assert.equal(ok.app.payments.gate().open, true, 'поддержка в боте есть кому читать — открыто');
+  ok.app.store.close();
+
+  const t = shop({ mode: 'live', support: 'bot' }, { admins: [] });
+  const g = t.app.payments.gate();
+  assert.equal(g.open, false);
+  assert.ok(g.reasons.some((r) => /ADMINS пуст/.test(r)), g.reasons.join(' | '));
+  assert.equal((await buy(t, ALICE, 'graphit-table')).error?.code, 'PAY_CLOSED', 'счёт не выставляется');
+  assert.equal(calls(t, 'createInvoiceLink').length, 0);
+  // Обычный контакт (@ник) от ADMINS не зависит.
+  assert.equal(gate(cfgOf({ mode: 'live', support: '@help' }), { botSupport: false }).open, true);
+  t.app.store.close();
+});
+
 test('продаётся только «Графит»: «Ночной казино-клуб» и выдуманные id в предложения не попадают', () => {
