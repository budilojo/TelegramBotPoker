# Скопируйте в .env.ux; секреты не отправлять в чат и не коммитить.
UX_BOT_TOKEN=
# Число перед двоеточием в токене НОВОГО тестового бота
UX_BOT_ID=
# ID основного бота (не секрет), должен отличаться
UX_PRODUCTION_BOT_ID=
UX_WEBAPP_URL=https://ux.example.invalid
UX_MINIAPP=cardgameux
UX_PORT=8081
# Telegram ID разработчиков/тестировщиков, через запятую
UX_TESTERS=
