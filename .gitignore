node_modules/
data/rooms.json
.DS_Store
*.log

# редакторское/агентское, к продукту отношения не имеет
.claude/*
!.claude/agents/

# Telegram-бот: локальная база столов
data/bot.db
data/bot.db-*

# токен бота и прочие секреты — никогда в git
.env
.env.*
!.env.example

# скриншоты стола (npm run preview) — собираются заново, в git не нужны
preview/

# бэкапы базы: их снимает deploy/backup.sh на сервере, в git им делать нечего
backups/

# Проверочная копия новой версии при обновлении сервера (deploy/update.sh)
.update-check/

# готовые картинки владельца до подключения (README остаётся в git)
assets-incoming/*
!assets-incoming/README.md

# состояние единого запуска «Графит» (tools/graphit-run.mjs): журналы, блокировка, состояние
.graphit-run/
